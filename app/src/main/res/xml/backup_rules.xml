<?xml version="1.0" encoding="utf-8"?>
<!--
    Respaldo automático de Android (versiones anteriores a la 12).
    No se respalda nada: la base de datos, la sesión y las fotos se quedan en el teléfono.
    Los datos del usuario ya se guardan en Cloud Firestore con su cuenta.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
